{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/wedding-invitation/browser",
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "acara", "value": "cimahi" }], "destination": "/cimahi.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
