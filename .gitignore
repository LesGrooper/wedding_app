# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
.env
**/package-lock.json

# Di-generate dari .env oleh scripts/generate-env.mjs — berisi data pribadi
/src/environments/environment.ts
/src/environments/environment.prod.ts

# Cache font TTF untuk scripts/generate-icons.mjs — diunduh otomatis saat
# `pnpm run icons`, tidak perlu masuk repo (±1,6 MB). Aset hasilnya di
# public/ yang justru WAJIB di-commit.
/scripts/fonts/

# Kredensial Google Cloud service account — JANGAN pernah di-commit
wedding-app-*.json
*-service-account*.json

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www
/.angular

resources/ios/**/*
resources/android/**/*

/.scannerwork
/.nx
/.env
/.editorconfig
# Backend Apps Script — sumber kebenarannya ada di editor script.google.com
apps-script
# Hasil sementara scripts/optimize-images.mjs — bukan sumber kebenaran
/assets-optimized
