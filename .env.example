# ============================================================
# Template .env — salin jadi `.env` lalu isi nilainya:
#   cp .env.example .env
# Lalu generate environment files:
#   pnpm run config:env
# ============================================================

# Apps Script Web App endpoint (/exec) — lihat apps-script/README.md
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
# Opsional: override khusus build production
# APPS_SCRIPT_URL_PROD=

# ------------------------------------------------------------
# Acara — satu web untuk beberapa acara, dipilih lewat ?acara=<kunci>
#   domain.com/?acara=cimahi&to=budi-santoso
# Kunci pertama = default (link tanpa ?acara=). Hanya huruf a-z.
# Tiap kunci butuh blok <KUNCI>_* di bawah; tema warnanya di src/styles.css
# (blok :root[data-acara="<kunci>"]).
# ------------------------------------------------------------
EVENTS=banjar,cimahi

# ---- Banjar — Akad & Resepsi ----
# Tanggal & jam acara (ISO 8601 dengan timezone)
BANJAR_EVENT_DATE=2026-01-01T10:00:00+07:00
# Opsional: override khusus build production
# BANJAR_EVENT_DATE_PROD=
# Jadwal (teks bebas, ditampilkan apa adanya di bawah countdown)
BANJAR_AKAD_TIME=08.00 – 10.00 WIB
BANJAR_RECEPTION_TIME=11.00 WIB – Selesai
BANJAR_VENUE_NAME=Nama Gedung / Venue
BANJAR_VENUE_ADDRESS=Jl. Contoh No. 1, Kota
BANJAR_VENUE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
BANJAR_VENUE_MAPS_OPEN_URL=https://maps.google.com/?q=...

# ---- Cimahi — Ngunduh Mantu ----
CIMAHI_EVENT_DATE=2026-01-08T11:00:00+07:00
# Boleh kosong — kolom akad di countdown otomatis disembunyikan
CIMAHI_AKAD_TIME=
CIMAHI_RECEPTION_TIME=11.00 WIB – Selesai
CIMAHI_VENUE_NAME=Nama Gedung / Venue
CIMAHI_VENUE_ADDRESS=Jl. Contoh No. 2, Cimahi
CIMAHI_VENUE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
CIMAHI_VENUE_MAPS_OPEN_URL=https://maps.google.com/?q=...

# Mempelai pria
GROOM_NAME=Nama Mempelai Pria
GROOM_FATHER=(Nama Ayah)
GROOM_MOTHER=(Nama Ibu)
GROOM_PHOTO=assets/images/groom.jpg

# Mempelai wanita
BRIDE_NAME=Nama Mempelai Wanita
BRIDE_FATHER=(Nama Ayah)
BRIDE_MOTHER=(Nama Ibu)
BRIDE_PHOTO=assets/images/bride.jpg

# Cerita cinta & kalimat penutup kini di Services/transliteration.service.ts (dwibahasa ID/EN).

# Wedding gift — rekening mempelai (atas nama otomatis dari GROOM_NAME/BRIDE_NAME).
# Kosongkan bank+nomor salah satu kalau cuma mau 1 rekening.
GIFT_GROOM_BANK=Bank BCA
GIFT_GROOM_NUMBER=1234567890
GIFT_BRIDE_BANK=Bank Mandiri
GIFT_BRIDE_NUMBER=0987654321
